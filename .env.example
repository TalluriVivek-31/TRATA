# CYCLONEX Environment Configuration Template
# DO NOT commit real secrets or production keys to version control.

# Server Configuration
CYCLONEX_HOST=127.0.0.1
CYCLONEX_PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:3000

# Map Provider API Key
# If using a commercial tile/geocoding service (e.g. Mapbox, MapTiler, Stadia), configure below.
# Default fallback: High-contrast Dark CartoDB Matter & OpenStreetMap tiles (no key required)
MAP_API_KEY=your_map_api_key_here

# Open-Meteo Integration
# Standard forecast API is open for educational & research non-commercial usage.
# If an enterprise commercial license key is acquired, provide below:
OPEN_METEO_API_KEY=

# ISRO MOSDAC Satellite Ingestion Credentials (Optional for OpenSearch metadata)
# Required ONLY for downloading raw Level-1 / Level-2 HDF5 (.h5) binary files
# Register for an account at https://mosdac.gov.in
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_DOWNLOAD_PATH=./data/mosdac_downloads

# NASA Earthdata Login (URS) Credentials (Optional)
# Required ONLY for restricted granule downloads (e.g. raw Level-1/2 HDF/NetCDF science data).
# Public CMR metadata search, NASA GIBS WMTS tiles, and NASA POWER Climatology require NO credentials.
# Register for an account at https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_BEARER_TOKEN=

# Firebase Authentication (Optional override)
FIREBASE_PROJECT_ID=trata-f4b62
FIREBASE_WEB_API_KEY=AIzaSyAmdMi2cNo09nmMwbnQWObCxba638Z16Hk

# India Meteorological Department (IMD) API Gateway
# Official API Management Platform: https://api.imd.gov.in
# Requires authorized organization registration & IP whitelisting or API key
IMD_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=

